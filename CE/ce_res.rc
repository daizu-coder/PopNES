#include <windows.h>
#include "ce_resource.h"

/* Main menu mascot (MainMenuDlgProc WM_PAINT in ce_main.c):
 * popnes_mascot_B_banzai.png (260x98 RGBA) pre-composited onto the menu's
 * cream background #F0E1BC as a 24bpp BMP - this coredll has no
 * TransparentBlt/AlphaBlend, so the transparency is baked in. */
IDB_MAINMENU BITMAP  "popnes_mascot.bmp"

/* TODO(new port): icon1.ico was snes9xCE/PicoDrive-specific artwork and
 * has been removed from this template. If your emulator has its own
 * .ico, drop it in this folder and uncomment the line below (pointing
 * at your filename); otherwise leave it commented out and the app runs
 * with no custom icon (LoadIconW(IDI_MAIN) in ce_main.c returns NULL
 * when this resource is absent, which is harmless - RegisterClassW
 * accepts a NULL hIcon). */
/* IDI_MAIN ICON "icon1.ico" */

/* Touch-to-reveal "menu": plain DialogBoxW + PUSHBUTTON controls (see
 * ce_resource.h for why - this coredll doesn't export SetMenu). English
 * captions only: this .rc is compiled by windres and we have not
 * verified Japanese text survives that pipeline intact on this
 * toolchain, whereas the C-side wide string literals (MessageBoxW text
 * etc.) are confirmed working via \x-escaped UTF-16 - keep Japanese
 * strings there, not in resource scripts.
 *
 * Layout matches the sister smsCE project's IDD_MAINMENU control-for-
 * control (same rects, same 210x140 size, ported per user request to be
 * "exactly the same"): Open ROM full width (WS_GROUP so Up/Down *wrap*
 * at the first/last button - see ce_resource.h), Save/Load State as a
 * 2-up row, the three config dialogs as a 3-up row in the same slot
 * smsCE's Misc/Sound/Keys occupy, Exit full width, and a footer hint
 * line instead of a separate Resume/About button - resuming is just the
 * physical Back key (IDCANCEL), matching smsCE exactly; there's no
 * equivalent slot for About in a 4-row layout, so it's gone too.
 * DS_CENTER dropped and WS_SYSMENU added (round 21, user request) to
 * match smsCE's own dialogs pixel-for-pixel: positioned at its resource
 * x/y (0,0, i.e. the screen's top-left corner) instead of centered, with
 * a system "X" close box in the caption bar. That box isn't a dialog
 * control, so it never enters this dialog's physical-key focus chain;
 * tapping it delivers IDCANCEL the same way the physical Back key
 * already does (see MainMenuDlgProc's IDCANCEL case below), so no new
 * handling was needed for it to work.
 *
 * Stays 210x140 - NOT grown to match IDD_INPUTCONFIG's own 190x170
 * (user correction, picodrive-upgrade round): an earlier pass here
 * grew this dialog to 170 too, reasoning by analogy from round 27's own
 * real-hardware bug report (an *eleven*-row IDD_INPUTCONFIG that used to
 * be 190x170 left its OK button behind as a visual artifact until its
 * height was shrunk to match this dialog's 140). That analogy doesn't
 * hold up under closer inspection of the sister picodrive-master CE
 * project this round is borrowing from: picodrive-master's own
 * IDD_MAINMENU has stayed 210x140 through every round (including round
 * 30, the one that grew *its* IDD_INPUTCONFIG to the same 190x170/8-row
 * shape this file now also uses) and picodrive-master's own round 23
 * real-hardware confirmation of that exact size mismatch ("完璧正常
 * です") never reported this artifact - on identical ce_main.c
 * WM_PAINT/ShowMainMenuDialog logic (both ports share the same
 * shared CE app template, unmodified in this area). So a mismatched
 * height between these two dialogs is not, by itself, the artifact's
 * cause; round 27's real fix likely happened to also address whatever
 * the actual cause was, or that cause was specific to conditions this
 * round hasn't reproduced. Matching picodrive-master's own confirmed
 * numbers exactly (this dialog unresized) is the more defensible
 * "investigate properly, do exactly what picodrive-master does" answer
 * than guessing at a new workaround - see IDD_INPUTCONFIG's own comment
 * below for the actual current height (190x170). If a leftover-artifact
 * bug does resurface on real hardware with this exact size combination,
 * re-open it as a fresh,
 * hardware-verified investigation rather than re-applying the same
 * height-matching guess. */
IDD_MAINMENU DIALOG 0, 0, 210, 154
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
/* Kept in sync with CE_APP_TITLE in ce_app_config.h (currently
 * L"PopNES") by hand, not via macro - windres' CAPTION handling of
 * a wide (L"...") literal is unverified on this toolchain, so this one
 * English title has always been a plain narrow literal here (the C side
 * works around the equivalent Japanese-text risk by keeping all
 * translated strings out of .rc entirely, see comment above). This was
 * still the template's own placeholder text (a generic "Sample" title) until
 * caught by user review - remember to update this line to match
 * whatever CE_APP_TITLE says for any future port cloned from this
 * file. */
CAPTION "PopNES"
FONT 9, "Tahoma"
BEGIN
    PUSHBUTTON "Open ROM...", IDC_MM_OPEN,       8,  8, 194, 20, WS_GROUP | WS_TABSTOP | BS_OWNERDRAW
    PUSHBUTTON "Save State",  IDC_MM_SAVESTATE,  8, 32,  93, 20, BS_OWNERDRAW
    PUSHBUTTON "Load State",  IDC_MM_LOADSTATE, 109, 32,  93, 20, BS_OWNERDRAW
    PUSHBUTTON "Video Cfg",   IDC_MM_VIDEO,      8, 56,  59, 34, BS_OWNERDRAW
    PUSHBUTTON "Sound Cfg",   IDC_MM_SOUND,     75, 56,  60, 34, BS_OWNERDRAW
    PUSHBUTTON "Input Cfg",   IDC_MM_INPUT,    143, 56,  59, 34, BS_OWNERDRAW
    PUSHBUTTON "Screenshot",  IDC_MM_SCREENSHOT, 8, 94,  93, 20, BS_OWNERDRAW
    PUSHBUTTON "Exit",        IDC_MM_EXIT,     109, 94,  93, 20, BS_OWNERDRAW
    LTEXT "Press Back to resume the game.", IDC_MM_HINT, 8, 122, 194, 20
END

/* Two columns (D-pad + diagonal combos on the left, NES Select/Start/A/B
 * plus this core's Turbo A/Turbo B on the right) of label + remap-button
 * pairs, plus a footer row - see ce_input.c for the remap-by-press logic
 * and ce_resource.h for why this is a plain DialogBox like IDD_MAINMENU.
 * QuickNES only has 8 real NES buttons (D-pad/Select/Start/A/B); of the
 * four extra retro-joypad IDs this 12-slot layout inherited from the
 * PicoDrive-derived template, libretro.cpp's bindmap[]/desc_ps[] wires
 * X/Y to Turbo A/Turbo B - those stay remappable here - while L/R (Prev./
 * Next Color Palette) were dropped from this dialog entirely (round 25,
 * user request): no label, no remap button, not part of the physical-key
 * focus loop (see ce_input.c's kInputOrder) - CeInputPoll()/CeInputState()
 * still read them via s_map[]'s own default key ('Q'/'W'), they just
 * aren't user-remappable from this screen any more.
 *
 * Diagonal D-pad combos (Up R/R Down/Down L/L Up - picodrive-upgrade
 * round, user request "picodriveを参考にしてInput Configをアップグレード
 * して下さい", ported from the sister picodrive-master CE project's own
 * Input Config): a single physical key can now drive two D-pad
 * directions at once, useful on a device with few dedicated buttons.
 * They fill out the left column to 8 rows, same row count and y-spacing
 * (17 DLU pitch, 8/25/42/59/76/93/110/127) as picodrive-master's own
 * IDD_INPUTCONFIG - real-hardware-confirmed there (that project's round
 * 30). No natural right-column companion for these four rows (nothing
 * left to remap once Select/Start/A/B/TurboA/TurboB are placed), so
 * those slots are simply blank, same as picodrive-master leaving its own
 * Select/Mode row blank.
 *
 * Select/Start sit one row lower than where the diagonal combos would
 * otherwise put them (user request, picodrive-upgrade round follow-up):
 * row 5's right-hand slot (next to Up R) is now blank, Select moved from
 * row 5 to row 6 (next to R Down) and Start from row 6 to row 7 (next to
 * Down L) - row 8 (next to L Up) stays blank on the right. Relative
 * order (A, B, TurboA, TurboB, then Select, then Start, top-to-bottom)
 * is unchanged, so ce_input.c's kInputOrder[] needed no change.
 *
 * Every row shares one label width (32) and one remap-button width (48),
 * left-aligned button-right-after-label (round 26, user request) - label
 * at x=6 (left column) / x=104 (right column), button 2px after the
 * label ends (x=40 / x=138); that's this project's own established
 * spacing (round 26), kept as-is rather than switched to
 * picodrive-master's slightly narrower x=96/x=134 right column, since
 * only the row *count* and *pitch* are being borrowed here, not every
 * pixel value. Total height is 170 (was 140) to fit the four new rows -
 * IDD_MAINMENU, unlike an earlier pass in this same round, is *not*
 * grown to match: see that dialog's own comment for why (picodrive-
 * master's own IDD_MAINMENU stays 210x140 despite its IDD_INPUTCONFIG
 * being this same 190x170, real-hardware-confirmed without a leftover-
 * artifact problem). No Cancel button - see IDD_SOUNDCONFIG's comment on
 * why; WS_GROUP on the first remap button makes Up/Down wrap through OK
 * and back, same mechanism as IDD_MAINMENU above. No Reset to Defaults
 * button either (round 21, user request). DS_CENTER dropped and
 * WS_SYSMENU added (round 21) - see IDD_MAINMENU's comment above for
 * why. */
IDD_INPUTCONFIG DIALOG 0, 0, 190, 170
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Input Config"
FONT 9, "Tahoma"
BEGIN
    /* 2026-09-27 (PopPCE と同じ変更): remap buttons widened to 54 - the
     * Galmuri14 font's "Press key"/"Backspace" overflowed 48 on real
     * hardware (PopPCE). The dialog width is unchanged; the gaps between
     * the columns and the right margin were narrowed instead. */
    LTEXT     "Up",       IDC_IC_LBL_UP,    6,  9, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_UP,   40,  8, 54, 14, WS_GROUP | WS_TABSTOP | BS_OWNERDRAW
    LTEXT     "A",        IDC_IC_LBL_A,   98,  9, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_A,   132,  8, 54, 14, BS_OWNERDRAW

    LTEXT     "Down",     IDC_IC_LBL_DOWN,  6, 26, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_DOWN, 40, 25, 54, 14, BS_OWNERDRAW
    LTEXT     "B",        IDC_IC_LBL_B,   98, 26, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_B,   132, 25, 54, 14, BS_OWNERDRAW

    LTEXT     "Left",     IDC_IC_LBL_LEFT,  6, 43, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_LEFT, 40, 42, 54, 14, BS_OWNERDRAW
    LTEXT     "TurboA",   IDC_IC_LBL_TURBOA, 98, 43, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_X,   132, 42, 54, 14, BS_OWNERDRAW

    LTEXT     "Right",    IDC_IC_LBL_RIGHT, 6, 60, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_RIGHT,40, 59, 54, 14, BS_OWNERDRAW
    LTEXT     "TurboB",   IDC_IC_LBL_TURBOB, 98, 60, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_Y,   132, 59, 54, 14, BS_OWNERDRAW

    LTEXT     "Up R",     IDC_IC_LBL_UPRIGHT,   6, 77, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_UPRIGHT,  40, 76, 54, 14, BS_OWNERDRAW

    LTEXT     "R Down",   IDC_IC_LBL_RIGHTDOWN, 6, 94, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_RIGHTDOWN,40, 93, 54, 14, BS_OWNERDRAW
    LTEXT     "Select",  IDC_IC_LBL_SELECT, 98, 94, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_SELECT,  132, 93, 54, 14, BS_OWNERDRAW

    LTEXT     "Down L",   IDC_IC_LBL_DOWNLEFT,  6,111, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_DOWNLEFT, 40,110, 54, 14, BS_OWNERDRAW
    LTEXT     "Start",    IDC_IC_LBL_START,  98,111, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_START,   132,110, 54, 14, BS_OWNERDRAW

    LTEXT     "L Up",     IDC_IC_LBL_LEFTUP,   6,128, 32, 12
    PUSHBUTTON "",        IDC_IC_BTN_LEFTUP,   40,127, 54, 14, BS_OWNERDRAW

    DEFPUSHBUTTON "OK",                IDOK,          70, 147,  50, 14, BS_OWNERDRAW
END

/* Volume/Rate/Bits/Quality are all "-/value/+" spinners now (ported
 * from the sister smsCE project's own Sound Settings dialog, per user
 * request), not a COMBOBOX + RADIOBUTTON pairs - the value lives on a
 * WS_TABSTOP PUSHBUTTON in the middle so it gets a native focus
 * rectangle and a place in the physical-key Up/Down/Left/Right loop
 * (see ce_audio.c's SoundConfigDlgProc/SoundCtrlProc); the "-"/"+"
 * buttons on either side are touch-only (no WS_TABSTOP), matching
 * smsCE's IDC_FRAMESKIP_MINUS/PLUS. The separate Mute checkbox is gone
 * too - Volume all the way down to 0 already silences output (same
 * design as smsCE's Volume 0..10 replacing its old "No Sound" radio
 * choice), so a second, redundant control for the same thing didn't
 * carry over. No Cancel button: this device has no meaningful "discard
 * changes" gesture, only "go back" - the physical Back key (IDCANCEL)
 * commits and closes exactly like OK does (see SoundConfigDlgProc). This
 * dialog was 190x104 with OK at (70,86,50,14), matching every settings/
 * picker dialog smsCE has (Misc/Sound/Keys/ROM picker all share that
 * footprint there too) - same OK position as this project's own Video
 * Config/ROM picker. DS_CENTER dropped and WS_SYSMENU added (round 21)
 * - see IDD_MAINMENU's comment above for why.
 *
 * Round 17 (user request) briefly added a 5th row, "Buffer:" (ring
 * cushion in ms), growing the dialog to 190x121. Reverted in round 18:
 * the user reported a noticeable perceived slowdown on real hardware
 * after that change and asked for it to be backed out, so this dialog
 * is back to its original 4-row/190x104 footprint matching every other
 * settings/picker dialog in this port. */
IDD_SOUNDCONFIG DIALOG 0, 0, 190, 121
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Sound Config"
FONT 9, "Tahoma"
BEGIN
    LTEXT      "Volume:",  IDC_SC_LBL_VOLUME,     8,  9, 44,  8
    PUSHBUTTON "-",        IDC_SC_VOLUME_MINUS,  53,  7, 14, 12, BS_OWNERDRAW
    PUSHBUTTON "10",       IDC_SC_VOLUME_VALUE,  68,  6, 20, 14, WS_TABSTOP | BS_OWNERDRAW
    PUSHBUTTON "+",        IDC_SC_VOLUME_PLUS,   89,  7, 14, 12, BS_OWNERDRAW

    LTEXT      "Rate:",    IDC_SC_LBL_RATE,       8, 26, 30,  8
    PUSHBUTTON "-",        IDC_SC_RATE_MINUS,    53, 24, 14, 12, BS_OWNERDRAW
    PUSHBUTTON "Native",   IDC_SC_RATE_VALUE,    68, 23, 60, 14, WS_TABSTOP | BS_OWNERDRAW
    PUSHBUTTON "+",        IDC_SC_RATE_PLUS,    129, 24, 14, 12, BS_OWNERDRAW

    LTEXT      "Bits:",    IDC_SC_LBL_BITS,       8, 42, 30, 10
    PUSHBUTTON "-",        IDC_SC_BITS_MINUS,    45, 41, 14, 12, BS_OWNERDRAW
    PUSHBUTTON "16-bit",   IDC_SC_BITS_VALUE,    60, 40, 63, 14, WS_TABSTOP | BS_OWNERDRAW
    PUSHBUTTON "+",        IDC_SC_BITS_PLUS,    124, 41, 14, 12, BS_OWNERDRAW

    LTEXT      "Quality:", IDC_SC_LBL_QUALITY,    8, 59, 34, 10
    PUSHBUTTON "-",        IDC_SC_QUALITY_MINUS, 45, 58, 14, 12, BS_OWNERDRAW
    PUSHBUTTON "Smooth",   IDC_SC_QUALITY_VALUE, 60, 57, 63, 14, WS_TABSTOP | BS_OWNERDRAW
    PUSHBUTTON "+",        IDC_SC_QUALITY_PLUS, 124, 58, 14, 12, BS_OWNERDRAW

    /* Buffer: ring buffer capacity, shown in KB (ce_audio.c's
     * UpdateBufferLabel). Round 18 removed an earlier version of this
     * row for a perceived slowdown; re-added from the shared CE app
     * template with the default (8192 = 16 KB) left where round 18 put
     * it, so the spinner is purely opt-in. */
    LTEXT      "Buffer:",  IDC_SC_LBL_BUFFER,     8, 76, 34, 10
    PUSHBUTTON "-",        IDC_SC_BUFFER_MINUS,  45, 75, 14, 12, BS_OWNERDRAW
    PUSHBUTTON "16 KB",    IDC_SC_BUFFER_VALUE,  60, 74, 63, 14, WS_TABSTOP | BS_OWNERDRAW
    PUSHBUTTON "+",        IDC_SC_BUFFER_PLUS,  124, 75, 14, 12, BS_OWNERDRAW

    DEFPUSHBUTTON "OK",    IDOK,                  70, 103, 50, 14, BS_OWNERDRAW
END

/* Scale (see CeScaleMode in ce_video.h for what each of the 4 modes
 * does), Transparency Effects, Frame Skip (a "-/value/+" spinner, same
 * reasoning as Sound Config's rows above), the English/Japanese toggle
 * (round 24: also a "-/value/+" spinner now, see ce_resource.h's
 * comment on IDC_VC_JAPANESE) - this project's closest analogue to
 * smsCE's Misc dialog. Open Last Folder used to live here too; it's now
 * always on with no checkbox (user request, same as PopSNES), so the
 * dialog shrank 132 -> 118. Scale was a 2x2 RADIOBUTTON grid until round 21 (user
 * request); now a single "-/value/+" spinner cycling through 4 states
 * displayed as x1/x1.5/Wide/Full (see ce_video.c's kScaleOrder/
 * kScaleLabels), same pattern as Frame Skip below and Sound Config's
 * Volume/Rate/Bits/Quality - one fewer row than the old grid, so the
 * dialog is shorter (116 vs. 130). No Cancel button - see
 * IDD_SOUNDCONFIG's comment above. Width unified to 190 like every
 * other settings/picker dialog. DS_CENTER dropped and WS_SYSMENU added
 * (round 21) - see IDD_MAINMENU's comment above for why. Round 25 (user
 * request) first moved IDC_VC_LANG_MINUS to the same x=45 as
 * IDC_VC_SCALE_MINUS above it and narrowed the value readout from 142
 * to 100; round 26 (user request, after seeing that on hardware)
 * abandoned matching Scale's x and instead centers the whole "-/value/
 * +" group horizontally within this dialog's own 190 width (unlike
 * Scale/Frame Skip above, which stay flush left under their own
 * "Scale:"/"Frame Skip:" captions - this row has no such caption to
 * stay flush with), and narrowed the value readout again, to 90 (both
 * "GAIKOKU-English" and "NIHON-Japanese" still fit - IDC_VC_JAPANESE is
 * one control shown at two different strings, not two controls, so
 * they're always exactly the same box). */
IDD_VIDEOCONFIG DIALOG 0, 0, 190, 118
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Video Config"
FONT 9, "Tahoma"
BEGIN
    LTEXT       "Scale:",       IDC_VC_LBL_SCALE,        8,  9, 30,  8
    PUSHBUTTON  "-",            IDC_VC_SCALE_MINUS,     45,  7, 14, 12, BS_OWNERDRAW
    PUSHBUTTON  "x1",           IDC_VC_SCALE_VALUE,     60,  6, 40, 14, WS_TABSTOP | BS_OWNERDRAW
    PUSHBUTTON  "+",            IDC_VC_SCALE_PLUS,      101,  7, 14, 12, BS_OWNERDRAW

    CHECKBOX    "No Sprite Limit", IDC_VC_TRANSPARENCY,  8, 24, 160, 12, BS_OWNERDRAW

    /* Frame Skip row: unlike the sister PicoDrive/snes9x2002 CE ports
     * this dialog was templated from, QuickNES's libretro.cpp neither
     * exposes a "*_frameskip" GET_VARIABLE key nor ever calls
     * RETRO_ENVIRONMENT_SET_AUDIO_BUFFER_STATUS_CALLBACK (confirmed by
     * grep) - but it DOES implement a different, genuine frame-skip
     * mechanism (RETRO_ENVIRONMENT_GET_AUDIO_VIDEO_ENABLE ->
     * nes_emu/Nes_Emu.cpp's emulate_skip_frame(), CPU/APU run as normal,
     * only PPU pixel writes are skipped - see ce_video.h's
     * CeVideoFrameSkipDecide comment). This row drives
     * that mechanism instead, fitted into the gap this dialog already
     * reserved for exactly this. The dialog height is now 118 (Enable
     * Debug Logging checkbox added, Open Last Folder removed) - still within
     * IDD_MAINMENU's 210x140 footprint, which any main-menu dialog must
     * stay inside or it leaves paint artifacts behind it. */
    /* Value box width (40px) unchanged since round 29 - "Off" and any
     * 2-digit number (up to "30", round 31's widened ceiling) both fit
     * comfortably. */
    LTEXT       "Frame Skip:",    IDC_VC_LBL_FRAMESKIP,   8, 41,  60,  8
    PUSHBUTTON  "-",              IDC_VC_FRAMESKIP_DOWN, 95, 39,  14, 12, BS_OWNERDRAW
    PUSHBUTTON  "Off",            IDC_VC_FRAMESKIP_LABEL,110, 38,  40, 14, WS_TABSTOP | BS_OWNERDRAW
    PUSHBUTTON  "+",              IDC_VC_FRAMESKIP_UP,  151, 39,  14, 12, BS_OWNERDRAW

    /* Round 26 (user request): this row's "-/value/+" group (total
     * width 14+2+90+2+14=122) is centred within the dialog's own 190
     * width - (190-122)/2=34 either side - rather than lining up with
     * any other row's column, since it has no leading caption of its
     * own to align under. */
    PUSHBUTTON  "-",              IDC_VC_LANG_MINUS,      34, 61,  14, 12, BS_OWNERDRAW
    PUSHBUTTON  "GAIKOKU-English", IDC_VC_JAPANESE,       50, 60,  90, 14, WS_TABSTOP | BS_OWNERDRAW
    PUSHBUTTON  "+",              IDC_VC_LANG_PLUS,      142, 61,  14, 12, BS_OWNERDRAW

    /* Enable Debug Logging (ported from the shared CE app template):
     * while unchecked (the default) CeLog() is a no-op and no log file
     * is created - see ce_log.h. Same BS_OWNERDRAW checkbox pitfall as
     * No Sprite Limit above; ce_video.c keeps s_debugLog as the source of
     * truth and paints it via CeBmpFontDrawOwnerCheckbox(). */
    CHECKBOX    "Enable Debug Logging", IDC_VC_DEBUGLOG, 8, 74, 160, 12, BS_OWNERDRAW

    DEFPUSHBUTTON "OK",  IDOK,                          70, 94, 50, 14, BS_OWNERDRAW
END

/* Custom ROM picker (see ce_fileopen.c) - replaces GetOpenFileNameW(),
 * ported to match the sister smsCE project's own IDD_FILEOPEN/
 * DLGFileOpen as closely as possible (same field layout; WS_SYSMENU
 * added here, unlike this project's other dialogs, to match its "X"
 * close box - DS_CENTER kept from this project's own convention since
 * it's already proven reliable here, whereas smsCE's version doesn't use
 * it). Folder-list + up-navigation ("<" as the first entry, not a real
 * file/folder) only, driven by the physical direction keys and the
 * decide/cancel keys - decide enters a folder or picks a file, cancel
 * goes up a folder or closes the picker at the root. Resized to 190x104
 * (from 200x130, user request) to match every settings/picker dialog
 * exactly, same OK position (70,86,50,14) as Sound/Video Config. */
IDD_FILEOPEN DIALOG 0, 0, 190, 108
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Select ROM"
FONT 9, "Tahoma"
BEGIN
    LTEXT      "",       IDC_FO_PATH, 6, 4, 178, 10
    /* Height trimmed 66 -> 64 (user request, real-hardware review) so
     * the last row the box can show is never a partial/clipped one -
     * see ce_fileopen.c's FileListCtrlProc for how the Left/Right
     * paging feature derives its own page size from whatever this
     * height actually resolves to in pixels at runtime, rather than
     * assuming a fixed row count here. */
    /* 2026-09-27 (PopPCE と同じ変更): list 64 -> 68, dialog 104 -> 108,
     * OK 86 -> 90 - with the Galmuri14 font's 19px rows the 6th row came
     * out cut off on real hardware (PopPCE). */
    LISTBOX               IDC_FO_LIST, 6, 16, 178, 68, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "OK",   IDOK,        70, 90, 50, 14, BS_OWNERDRAW
END

/* Generic message box (see ce_resource.h's IDD_MSGBOX comment and
 * ce_main.c's CeShowMsgBox()/MsgBoxDlgProc) - ported from the sister
 * gnuboy CE project's own IDD_MSGBOX, same dimensions/control layout.
 * Used only for the Save/Load State result messages, the only
 * Japanese-carrying MessageBoxW() calls this port ever made. */
IDD_MSGBOX DIALOG 0, 0, 134, 70
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "PopNES"
FONT 9, "Tahoma"
BEGIN
    LTEXT      "",     IDC_MB_TEXT, 8, 8, 118, 36
    DEFPUSHBUTTON "OK", IDOK,       42, 48, 50, 14, BS_OWNERDRAW
END

/* Save State confirmation (see ce_resource.h's IDD_SAVECONFIRM comment
 * and ce_main.c's SaveConfirmDlgProc/CeConfirmSaveState) - ported from
 * the sister gnuboy CE project's IDD_CONFIRM, same dimensions/control
 * layout (user request to match gnuboy's dialog; this replaced the
 * shared CE app template's "-"/はい|いいえ/"+" spinner). "セーブし
 * ますか？"/"Save State?" label plus two BS_OWNERDRAW はい/いいえ
 * (Yes/No) buttons drawn and key-handled by ce_main.c's
 * SaveConfirmDlgProc/SaveConfirmBtnCtrlProc; same self-drawn Shinonome
 * bitmap-font design as IDD_MSGBOX above. */
IDD_SAVECONFIRM DIALOG 0, 0, 134, 70
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "PopNES"
FONT 9, "Tahoma"
BEGIN
    LTEXT      "",      IDC_SF_TEXT, 8, 8, 118, 36
    DEFPUSHBUTTON "Yes", IDC_SF_YES, 18, 48, 45, 14, BS_OWNERDRAW
    PUSHBUTTON    "No",  IDC_SF_NO,  71, 48, 45, 14, BS_OWNERDRAW
END
